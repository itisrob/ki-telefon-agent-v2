            </div>
            <label class="toggle-switch">
                <input type="checkbox" data-category="functional">
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="cookie-category">
            <div class="cookie-category-info">
                <h4>Analyse-Cookies</h4>
