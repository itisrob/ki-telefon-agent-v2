            </div>
            <label class="toggle-switch">
                <input type="checkbox" data-category="analytics">
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="cookie-category">
            <div class="cookie-category-info">
                <h4>Marketing-Cookies</h4>
                <p>Affiliate-Tracking und personalisierte Inhalte.</p>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" data-category="marketing">
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
            <button class="btn btn-primary" id="cookieSaveSettings" style="flex: 1;">Auswahl speichern</button>
            <button class="btn btn-secondary" id="cookieAcceptAllSettings" style="flex: 1;">Alle akzeptieren</button>
        </div>
    </div>
</div>

